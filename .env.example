# Supabase project URL en service role key (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Server-only, NOOIT in de browser gebruiken.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# De gedeelde clubcode die leden invullen om binnen te komen.
# Wijzig je hem, dan moet iedereen de nieuwe code opnieuw invullen.
CLUB_CODE=kies-een-code
